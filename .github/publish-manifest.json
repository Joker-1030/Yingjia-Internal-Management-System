{
  "schemaVersion": 1,
  "mirrorType": "allowlist-candidate-tree",
  "description": "Exact publication boundary for the Engineering Public Mirror.",
  "include": [
    "README.md",
    ".gitignore",
    "package.json",
    "docs/PROJECT_OVERVIEW.md",
    "docs/GITHUB_PUBLISH_RULES.md",
    ".github/publish-manifest.json",
    ".github/scripts/build-publish-candidate.mjs",
    ".github/scripts/check-publish-policy.mjs",
    ".github/workflows/publish-check.yml",
    "scripts/build-prototype.mjs",
    "scripts/check-prototype-drift.mjs",
    "scripts/prototype-build-lib.mjs",
    "prd-workspace/current/PRD.md",
    "prd-workspace/current/modules/**",
    "prd-workspace/current/acceptance/**",
    "prd-workspace/current/shared/**",
    "prd-workspace/current/user-flows/**",
    "prd-workspace/decisions/**",
    "prd-workspace/DECISIONS.md",
    "prd-workspace/GLOSSARY.md",
    "prd-workspace/README.md",
    "demo-src/product-boundary-map.json",
    "demo/prototype.html",
    "demo/prototype.artifact.json",
    "src/**"
  ],
  "exclude": [
    "archive/**",
    "snapshots/**",
    "**/archive/**",
    "**/snapshots/**",
    "prd-workspace/current/governance/**",
    "prd-workspace/current/PRD_customer_management_full.md",
    "prd-workspace/history/**",
    "prd-workspace/review/**",
    "prd-workspace/increments/**",
    "docs/AI_IMPLEMENTATION_TASKS/**",
    "docs/AI_IMPLEMENTATION_RESULTS/**",
    "docs/AI_AGENT_REGISTRY.md",
    "docs/AI_COLLABORATION_RULES.md",
    "docs/archive/**",
    "docs/*GOVERNANCE*",
    "docs/*SEMANTIC*",
    "docs/*COMPLETION*",
    "docs/*MIGRATION*",
    "docs/*CLOSURE*",
    "docs/*REVALIDATION*",
    "docs/*REMEDIATION*",
    "demo/archive/**",
    "demo/PRD_*.html",
    "demo/demo-manifest.json",
    "demo/DEMO_HANDOFF.md",
    "CLEANUP_REPORT.md",
    "HANDOFF.md"
  ],
  "sensitiveExclusions": [
    "**/.env",
    "**/.env.*",
    "**/credentials",
    "**/credentials.*",
    "**/secret",
    "**/secret.*",
    "**/secrets/**",
    "**/token",
    "**/token.*",
    "**/tokens/**",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "**/id_rsa*",
    "**/id_ed25519*",
    "**/*.sqlite",
    "**/*.sqlite3",
    "**/*.db"
  ],
  "requiredFiles": [
    "README.md",
    "package.json",
    "docs/PROJECT_OVERVIEW.md",
    "docs/GITHUB_PUBLISH_RULES.md",
    ".github/publish-manifest.json",
    ".github/scripts/build-publish-candidate.mjs",
    ".github/scripts/check-publish-policy.mjs",
    ".github/workflows/publish-check.yml",
    "prd-workspace/current/PRD.md",
    "prd-workspace/current/modules/index.md",
    "prd-workspace/current/acceptance/index.md",
    "prd-workspace/current/shared/index.md",
    "prd-workspace/current/user-flows/index.md",
    "prd-workspace/decisions/index.md",
    "prd-workspace/GLOSSARY.md",
    "demo/prototype.html",
    "demo/prototype.artifact.json",
    "src/prototype.html",
    "scripts/build-prototype.mjs",
    "scripts/check-prototype-drift.mjs",
    "scripts/prototype-build-lib.mjs"
  ],
  "maxFileBytes": 10485760,
  "prototypeCheck": "npm run check:prototype"
}
